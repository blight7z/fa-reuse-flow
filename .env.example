# Copy to .env for local Docker usage. Do not commit real secrets.
POSTGRES_DB=fa_reuse_flow
POSTGRES_USER=fa_reuse
POSTGRES_PASSWORD=fa_reuse_local_only
DATABASE_URL=postgresql+psycopg://fa_reuse:fa_reuse_local_only@db:5432/fa_reuse_flow
SESSION_SECRET=replace-this-before-any-non-local-use
SESSION_COOKIE_SECURE=false
NEXT_PUBLIC_API_BASE_URL=/api/v1
INTERNAL_API_URL=http://api:8000
APP_TIMEZONE=Asia/Bangkok
BUSINESS_HOLIDAYS=
